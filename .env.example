APP_NAME=JobRadar
ENVIRONMENT=development
SECRET_KEY=change-me-before-deployment
DATABASE_URL=postgresql+psycopg://jobradar:jobradar@db:5432/jobradar
CORS_ORIGINS=http://localhost:3000
# Clé partagée API <-> n8n (routes /internal, en-tête X-API-Key). Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JOBRADAR_INTERNAL_KEY=
# n8n : clé de chiffrement des identifiants (à générer de la même façon, ne plus la changer ensuite)
N8N_ENCRYPTION_KEY=
N8N_VERSION=2.45.2
SCHEDULER_ENABLED=true
COLLECTION_INTERVAL_MINUTES=60
COLLECTION_SOURCES=demo
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
